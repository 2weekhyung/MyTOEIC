# Copy to .env and replace every CHANGE_ME before starting. Never commit .env.
# Runtime account: DML only on the dedicated mytoeic database.
DB_URL=jdbc:mysql://mytoeic-db:3306/mytoeic?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sslMode=DISABLED&allowPublicKeyRetrieval=true
DB_USERNAME=mytoeic_app
DB_PASSWORD=CHANGE_ME_APP_RANDOM_PASSWORD
# Only for compose.db-network.yml. Set the actual server network name in private .env.
# Also change DB_URL host to the existing MySQL container name when using this overlay.
DB_DOCKER_NETWORK=CHANGE_ME_EXISTING_DB_NETWORK
# Disabled by default: set true only for an explicitly approved deployment/migration.
DB_MIGRATE=false
DB_MIGRATION_USERNAME=mytoeic_migrator
DB_MIGRATION_PASSWORD=CHANGE_ME_MIGRATOR_RANDOM_PASSWORD
# For a new LOCAL database only. Not used in compose.existing-db.yml.
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_RANDOM_PASSWORD
# Enable only for initial account creation, then turn off and remove the password.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=CHANGE_ME_AT_LEAST_16_CHARACTERS
COOKIE_SECURE=true
SERVER_PORT=8080
HOST_PORT=18080
WEAK_THRESHOLD=0.60
CONSECUTIVE_ERRORS=2
MINIMUM_ATTEMPTS=5
MASTERY_THRESHOLD=0.80
REVIEW_INTERVALS=1,3,7,14,30
