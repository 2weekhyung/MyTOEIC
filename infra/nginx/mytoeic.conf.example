# Template: use a dedicated virtual host. Do not overwrite existing nginx configuration.
# Backend is bound to host loopback, default 18080; choose an unused port first.
limit_req_zone $binary_remote_addr zone=mytoeic_login:1m rate=5r/m;
server {
    listen 443 ssl;
    server_name mytoeic.example.invalid;
    ssl_certificate /etc/letsencrypt/live/mytoeic.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mytoeic.example.invalid/privkey.pem;
    client_max_body_size 64k;
    location = /api/auth/login {
        limit_req zone=mytoeic_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
